---
import { WORK } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'

const projects = [
  {
    name: 'Byakugan — API Monitoring Tool',
    description:
      'An API monitoring and observability tool focused on endpoint uptime and behavior.',
    tech: 'Go, React',
    image: '/View1.png',
    link: null,
  },
  {
    name: 'Centralized Logging & Monitoring Platform',
    description:
      'A work-in-progress platform concept exploring custom log collection, ingestion, and monitoring.',
    tech: 'Platform architecture, observability',
    image: '/View2.png',
    link: null,
  },
  {
    name: 'Cloud Platform Engineering',
    description:
      'Production work across AWS infrastructure, Terraform, Kubernetes, and CI/CD, including cloud cost and database migration performance improvements.',
    tech: 'AWS, Terraform, Kubernetes, Jenkins, GitHub Actions',
    image: '/me.png',
    link: null,
  },
]
---

<BaseLayout
  title="Portfolio"
  description="Selected platform engineering, cloud, and observability work."
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="slide">
    <TopLayout>
      <h2
        class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Projects & Platforms
      </h2>
    </TopLayout>
    <BottomLayout size="xl">
      <div class="flex w-full flex-wrap justify-center gap-2">
        {
          projects.map((project) => (
            <ProjectCard
              as={project.link ? 'a' : 'div'}
              href={project.link ?? undefined}
              heading={project.name}
              subheading={`${project.description} • ${project.tech}`}
              imagePath={project.image}
              altText={`${project.name} preview`}
              class="w-full sm:w-2/5"
            />
          ))
        }
      </div>
    </BottomLayout>
  </main>
</BaseLayout>
